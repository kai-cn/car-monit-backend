<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.OdsSzdnGantryIpMapper">

    <resultMap type="com.ruoyi.base.domain.OdsSzdnGantryIp" id="OdsSzdnGantryIpResult">
        <result property="id"    column="id"    />
        <result property="gantryCode"    column="gantry_code"    />
        <result property="gantryName"    column="gantry_name"    />
        <result property="orgCode"    column="org_code"    />
        <result property="ip"    column="ip"    />
        <result property="brand"    column="brand"    />
        <result property="type"    column="type"    />

    </resultMap>

    <sql id="selectOdsSzdnGantryIpVo">
        t.id,
        t.gantry_code,
        t.gantry_name,
        t.org_code,
        t.ip,
        t.brand,
        t.type
    </sql>


    <select id="selectOdsSzdnGantryIpList" parameterType="com.ruoyi.base.domain.OdsSzdnGantryIp" resultMap="OdsSzdnGantryIpResult">
        SELECT
        <include refid="selectOdsSzdnGantryIpVo"/>
        FROM ods_szdn_gantry_ip t
        WHERE 1 = 1
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="gantryCode != null  and gantryCode != ''"> and t.gantry_code = #{gantryCode}</if>
        <if test="gantryName != null  and gantryName != ''"> and t.gantry_name like concat('%', #{gantryName}, '%')</if>
        <if test="orgCode != null  and orgCode != ''"> and t.org_code = #{orgCode}</if>
        <if test="ip != null  and ip != ''"> and t.ip = #{ip}</if>
        <if test="brand != null  and brand != ''"> and t.brand = #{brand}</if>
        <if test="type != null  and type != ''"> and t.type = #{type}</if>
        order by t.id
    </select>

    <select id="selectOdsSzdnGantryIpById" parameterType="Long" resultMap="OdsSzdnGantryIpResult">
         select
         <include refid="selectOdsSzdnGantryIpVo"/>
         from ods_szdn_gantry_ip t
         where t.id = #{id}
    </select>


</mapper>
