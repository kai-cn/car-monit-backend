    <select id="selectBaseGantrySnapshotFlowById" parameterType="String" resultMap="BaseGantrySnapshotFlowResult">
         select
         <include refid="selectBaseGantrySnapshotFlowVo"/>
         from base_gantry_snapshot_flow t
         where t.big_id = #{bigId}
    </select>


    <update id="deleteBaseGantrySnapshotFlowById" parameterType="String">
        update base_gantry_snapshot_flow set del_flag = '1' where big_id = #{bigId}
    </update>

    <update id="deleteBaseGantrySnapshotFlowByIds" parameterType="String">
        update base_gantry_snapshot_flow set del_flag = '1' where big_id in
        <foreach item="bigId" collection="array" open="(" separator="," close=")">
            #{bigId}
        </foreach>
    </update>
