    <select id="selectBaseGantrySnapshotFlowList" parameterType="com.ruoyi.base.domain.BaseGantrySnapshotFlow" resultMap="BaseGantrySnapshotFlowResult">
        SELECT
        <include refid="selectBaseGantrySnapshotFlowVo"/>
        FROM base_gantry_snapshot_flow t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="dataSource != null  and dataSource != ''"> and t.data_source = #{dataSource}</if>
        <if test="cameraType != null  and cameraType != ''"> and t.camera_type = #{cameraType}</if>
        <if test="deviceId != null  and deviceId != ''"> and t.device_id = #{deviceId}</if>
        <if test="gantryCode != null  and gantryCode != ''"> and t.gantry_code = #{gantryCode}</if>
        <if test="roadCode != null  and roadCode != ''"> and t.road_code = #{roadCode}</if>
        <if test="roadName != null  and roadName != ''"> and t.road_name like concat('%', #{roadName}, '%')</if>
        <if test="sectionCode != null  and sectionCode != ''"> and t.section_code = #{sectionCode}</if>
        <if test="sectionName != null  and sectionName != ''"> and t.section_name like concat('%', #{sectionName}, '%')</if>
        <if test="tollCode != null  and tollCode != ''"> and t.toll_code = #{tollCode}</if>
        <if test="tollName != null  and tollName != ''"> and t.toll_name like concat('%', #{tollName}, '%')</if>
        <if test="orgCode != null  and orgCode != ''"> and t.org_code = #{orgCode}</if>
        <if test="orgName != null  and orgName != ''"> and t.org_name like concat('%', #{orgName}, '%')</if>
        <if test="hexCode != null  and hexCode != ''"> and t.hex_code = #{hexCode}</if>
        <if test="direction != null "> and t.direction = #{direction}</if>
        <if test="pileno != null  and pileno != ''"> and t.pileno = #{pileno}</if>
        <if test="lon != null "> and t.lon = #{lon}</if>
        <if test="lat != null "> and t.lat = #{lat}</if>
        <if test="deviceIp != null  and deviceIp != ''"> and t.device_ip = #{deviceIp}</if>
        <if test="siteId != null "> and t.site_id = #{siteId}</if>
        <if test="laneId != null "> and t.lane_id = #{laneId}</if>
        <if test="snapshotTimeUnix != null "> and t.snapshot_time_unix = #{snapshotTimeUnix}</if>
        <if test="snapshotTime != null "> and t.snapshot_time = #{snapshotTime}</if>
        <if test="receivedTimeUnix != null "> and t.received_time_unix = #{receivedTimeUnix}</if>
        <if test="receivedTime != null  and receivedTime != ''"> and t.received_time = #{receivedTime}</if>
        <if test="plateNumber != null  and plateNumber != ''"> and t.plate_number = #{plateNumber}</if>
        <if test="plateColor != null  and plateColor != ''"> and t.plate_color = #{plateColor}</if>
        <if test="plateColorCode != null "> and t.plate_color_code = #{plateColorCode}</if>
        <if test="plateType != null  and plateType != ''"> and t.plate_type = #{plateType}</if>
        <if test="plateTypeCode != null "> and t.plate_type_code = #{plateTypeCode}</if>
        <if test="plateConfidence != null "> and t.plate_confidence = #{plateConfidence}</if>
        <if test="carBrand != null  and carBrand != ''"> and t.car_brand = #{carBrand}</if>
        <if test="carColor != null  and carColor != ''"> and t.car_color = #{carColor}</if>
