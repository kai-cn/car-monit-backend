<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.BaseGantryInfoMapper">

    <resultMap type="com.ruoyi.base.domain.BaseGantryInfo" id="BaseGantryInfoResult">
        <result property="id"    column="id"    />
        <result property="gantryCode"    column="gantry_code"    />
        <result property="gantryName"    column="gantry_name"    />
        <result property="roadCode"    column="road_code"    />
        <result property="sectionCode"    column="section_code"    />
        <result property="tollCode"    column="toll_code"    />
        <result property="orgCode"    column="org_code"    />
        <result property="hexCode"    column="hex_code"    />
        <result property="direction"    column="direction"    />
        <result property="pileNo"    column="pile_no"    />
        <result property="lon"    column="lon"    />
        <result property="lat"    column="lat"    />
        <result property="remark"    column="remark"    />
        <result property="isVirtual"    column="is_virtual"    />
        <result property="mileage"    column="mileage"    />
        <result property="boundaryGantryType"    column="boundary_gantry_type"    />
        <result property="gantryType"    column="gantry_type"    />
        <result property="cityCode"    column="city_code"    />
        <result property="districtName"    column="district_name"    />
        <result property="belongGroup"    column="belong_group"    />
        <result property="gantryCodeMerge"    column="gantry_code_merge"    />
        <result property="gantryNameAlias"    column="gantry_name_alias"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="remark2"    column="remark2"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectBaseGantryInfoVo">
        t.id,
        t.gantry_code,
        t.gantry_name,
        t.road_code,
        t.section_code,
        t.toll_code,
        t.org_code,
        t.hex_code,
        t.direction,
        t.pile_no,
        t.lon,
        t.lat,
        t.remark,
        t.is_virtual,
        t.mileage,
        t.boundary_gantry_type,
        t.gantry_type,
        t.city_code,
        t.district_name,
        t.belong_group,
        t.gantry_code_merge,
        t.gantry_name_alias,
        t.back_col1,
        t.back_col2,
        t.remark2,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectBaseGantryInfoList" parameterType="com.ruoyi.base.domain.BaseGantryInfo" resultMap="BaseGantryInfoResult">
        SELECT
        <include refid="selectBaseGantryInfoVo"/>
        FROM base_gantry_info t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="gantryCode != null  and gantryCode != ''"> and t.gantry_code = #{gantryCode}</if>
        <if test="gantryName != null  and gantryName != ''"> and t.gantry_name like concat('%', #{gantryName}, '%')</if>
        <if test="roadCode != null  and roadCode != ''"> and t.road_code = #{roadCode}</if>
        <if test="sectionCode != null  and sectionCode != ''"> and t.section_code = #{sectionCode}</if>
        <if test="tollCode != null  and tollCode != ''"> and t.toll_code = #{tollCode}</if>
        <if test="orgCode != null  and orgCode != ''"> and t.org_code = #{orgCode}</if>
        <if test="hexCode != null  and hexCode != ''"> and t.hex_code = #{hexCode}</if>
        <if test="direction != null  and direction != ''"> and t.direction = #{direction}</if>
        <if test="pileNo != null  and pileNo != ''"> and t.pile_no = #{pileNo}</if>
        <if test="lon != null  and lon != ''"> and t.lon = #{lon}</if>
        <if test="lat != null  and lat != ''"> and t.lat = #{lat}</if>
        <if test="isVirtual != null  and isVirtual != ''"> and t.is_virtual = #{isVirtual}</if>
        <if test="mileage != null  and mileage != ''"> and t.mileage = #{mileage}</if>
        <if test="boundaryGantryType != null  and boundaryGantryType != ''"> and t.boundary_gantry_type = #{boundaryGantryType}</if>
        <if test="gantryType != null  and gantryType != ''"> and t.gantry_type = #{gantryType}</if>
        <if test="cityCode != null  and cityCode != ''"> and t.city_code = #{cityCode}</if>
        <if test="districtName != null  and districtName != ''"> and t.district_name like concat('%', #{districtName}, '%')</if>
        <if test="belongGroup != null  and belongGroup != ''"> and t.belong_group = #{belongGroup}</if>
        <if test="gantryCodeMerge != null  and gantryCodeMerge != ''"> and t.gantry_code_merge = #{gantryCodeMerge}</if>
        <if test="gantryNameAlias != null  and gantryNameAlias != ''"> and t.gantry_name_alias = #{gantryNameAlias}</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="remark2 != null  and remark2 != ''"> and t.remark2 = #{remark2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectBaseGantryInfoById" parameterType="String" resultMap="BaseGantryInfoResult">
         select
         <include refid="selectBaseGantryInfoVo"/>
         from base_gantry_info t
         where t.id = #{id}
    </select>


    <update id="deleteBaseGantryInfoById" parameterType="String">
        update base_gantry_info set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteBaseGantryInfoByIds" parameterType="String">
        update base_gantry_info set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
