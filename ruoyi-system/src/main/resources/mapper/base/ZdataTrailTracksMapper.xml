<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.ZdataTrailTracksMapper">

    <resultMap type="com.ruoyi.base.domain.ZdataTrailTracks" id="ZdataTrailTracksResult">
        <result property="uuid"    column="uuid"    />
        <result property="type"    column="type"    />
        <result property="pointCount"    column="point_count"    />
        <result property="plateKey"    column="plate_key"    />
        <result property="enterTime"    column="enter_time"    />
        <result property="exitTime"    column="exit_time"    />
        <result property="trailPoints"    column="trail_points"    />
        <result property="enterLocationcode"    column="enter_locationcode"    />
        <result property="exitLocationcode"    column="exit_locationcode"    />
        <result property="trackJosn"    column="track_josn"    />
        <result property="enaxlecount"    column="enaxlecount"    />
        <result property="entolllaneid"    column="entolllaneid"    />
        <result property="entollstationid"    column="entollstationid"    />
        <result property="entollstationname"    column="entollstationname"    />
        <result property="envehicleclass"    column="envehicleclass"    />
        <result property="envehicleid"    column="envehicleid"    />
        <result property="envehicletype"    column="envehicletype"    />
        <result property="enweight"    column="enweight"    />
        <result property="extolllaneid"    column="extolllaneid"    />
        <result property="extollstationid"    column="extollstationid"    />
        <result property="extollstationname"    column="extollstationname"    />
        <result property="exvehicleclass"    column="exvehicleclass"    />
        <result property="exvehicleid"    column="exvehicleid"    />
        <result property="exvehicletype"    column="exvehicletype"    />
        <result property="exweight"    column="exweight"    />
    </resultMap>

    <sql id="selectZdataTrailTracksVo">
        t.uuid,
        t.type,
        t.point_count,
        t.plate_key,
        t.enter_time,
        t.exit_time,
        t.trail_points,
        t.create_time,
        t.enter_locationcode,
        t.exit_locationcode,
        t.track_josn,
        t.enaxlecount,
        t.entolllaneid,
        t.entollstationid,
        t.entollstationname,
        t.envehicleclass,
        t.envehicleid,
        t.envehicletype,
        t.enweight,
        t.extolllaneid,
        t.extollstationid,
        t.extollstationname,
        t.exvehicleclass,
        t.exvehicleid,
        t.exvehicletype,
        t.exweight
    </sql>


    <select id="selectZdataTrailTracksList" parameterType="com.ruoyi.base.domain.ZdataTrailTracks" resultMap="ZdataTrailTracksResult">
        SELECT
        <include refid="selectZdataTrailTracksVo"/>
        FROM zdata_trail_tracks t
        WHERE 1 = 1
        <if test="uuid != null  and uuid != ''"> and t.uuid = #{uuid}</if>
        <if test="type != null "> and t.type = #{type}</if>
        <if test="pointCount != null "> and t.point_count = #{pointCount}</if>
        <if test="plateKey != null  and plateKey != ''"> and t.plate_key = #{plateKey}</if>
        <if test="enterTime != null "> and t.enter_time = #{enterTime}</if>
        <if test="exitTime != null "> and t.exit_time = #{exitTime}</if>
        <if test="trailPoints != null  and trailPoints != ''"> and t.trail_points = #{trailPoints}</if>
        <if test="carNo != null  and carNo != ''"> and t.plate_key = #{carNo} </if>
        <if test="applyTime1 != null  and applyTime1 != ''">and t.enter_time >= STR_TO_DATE(#{applyTime1},'%Y-%m-%d')</if>
        <if test="applyTime2 != null  and applyTime2 != ''">and t.enter_time <![CDATA[<]]> date_add(STR_TO_DATE(#{applyTime2},'%Y-%m-%d'), interval 1 day) </if>
       order by t.enter_time desc
    </select>

    <select id="selectZdataTrailTracksById" parameterType="String" resultMap="ZdataTrailTracksResult">
         select
         <include refid="selectZdataTrailTracksVo"/>
         from zdata_trail_tracks t
         where t.uuid = #{uuid}
    </select>


    <select id="getHistoryTrail" parameterType="com.ruoyi.base.domain.ZdataTrailTracks" resultMap="ZdataTrailTracksResult">
        select
            t.uuid,
            t.type,
            t.point_count,
            t.plate_key,
            t.enter_time,
            t.exit_time,
            t.create_time,
            t.enter_locationcode,
            t.exit_locationcode,
            t.track_josn,
            t.enaxlecount,
            t.entolllaneid,
            t.entollstationid,
            t.entollstationname,
            t.envehicleclass,
            t.envehicleid,
            t.envehicletype,
            t.enweight,
            t.extolllaneid,
            t.extollstationid,
            t.extollstationname,
            t.exvehicleclass,
            t.exvehicleid,
            t.exvehicletype,
            t.exweight
        from zdata_trail_tracks t
        where 1=1
        <if test="carNo != null  and carNo != ''"> and t.plate_key = #{carNo} </if>
        <if test="applyTime1 != null  and applyTime1 != ''">and t.enter_time >= STR_TO_DATE(#{applyTime1},'%Y-%m-%d')</if>
        <if test="applyTime2 != null  and applyTime2 != ''">and t.enter_time <![CDATA[<]]> date_add(STR_TO_DATE(#{applyTime2},'%Y-%m-%d'), interval 1 day) </if>
        order by t.enter_time desc
    </select>


    <delete id="removeRealData">
        delete from zdata_trail_tracks t
        <where>
            <if test="carNoList != null and carNoList.size() > 0">
                plate_key in
                <foreach item="carNo" collection="carNoList" open="(" separator="," close=")">
                    #{carNo}
                </foreach>
            </if>
        </where>
    </delete>


</mapper>
