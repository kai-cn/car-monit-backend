<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.BaseSectionInfoMapper">

    <resultMap type="com.ruoyi.base.domain.BaseSectionInfo" id="BaseSectionInfoResult">
        <result property="id"    column="id"    />
        <result property="roadCode"    column="road_code"    />
        <result property="roadName"    column="road_name"    />
        <result property="sectionCode"    column="section_code"    />
        <result property="sectionName"    column="section_name"    />
        <result property="startPileNo"    column="start_pile_no"    />
        <result property="endPileNo"    column="end_pile_no"    />
        <result property="orgCode"    column="org_code"    />
        <result property="orgName"    column="org_name"    />
        <result property="orgLevelCode"    column="org_level_code"    />
        <result property="orgCategory"    column="org_category"    />
        <result property="mileage"    column="mileage"    />
        <result property="openDate"    column="open_date"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectBaseSectionInfoVo">
        t.id,
        t.road_code,
        t.road_name,
        t.section_code,
        t.section_name,
        t.start_pile_no,
        t.end_pile_no,
        t.org_code,
        t.org_name,
        t.org_level_code,
        t.org_category,
        t.mileage,
        t.open_date,
        t.back_col1,
        t.back_col2,
        t.remark,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectBaseSectionInfoList" parameterType="com.ruoyi.base.domain.BaseSectionInfo" resultMap="BaseSectionInfoResult">
        SELECT
        <include refid="selectBaseSectionInfoVo"/>
        FROM base_section_info t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="roadCode != null  and roadCode != ''"> and t.road_code = #{roadCode}</if>
        <if test="roadName != null  and roadName != ''"> and t.road_name like concat('%', #{roadName}, '%')</if>
        <if test="sectionCode != null  and sectionCode != ''"> and t.section_code = #{sectionCode}</if>
        <if test="sectionName != null  and sectionName != ''"> and t.section_name like concat('%', #{sectionName}, '%')</if>
        <if test="startPileNo != null "> and t.start_pile_no = #{startPileNo}</if>
        <if test="endPileNo != null "> and t.end_pile_no = #{endPileNo}</if>
        <if test="orgCode != null  and orgCode != ''"> and t.org_code = #{orgCode}</if>
        <if test="orgName != null  and orgName != ''"> and t.org_name like concat('%', #{orgName}, '%')</if>
        <if test="orgLevelCode != null  and orgLevelCode != ''"> and t.org_level_code = #{orgLevelCode}</if>
        <if test="orgCategory != null  and orgCategory != ''"> and t.org_category = #{orgCategory}</if>
        <if test="mileage != null "> and t.mileage = #{mileage}</if>
        <if test="openDate != null "> and t.open_date = #{openDate}</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectBaseSectionInfoById" parameterType="String" resultMap="BaseSectionInfoResult">
         select
         <include refid="selectBaseSectionInfoVo"/>
         from base_section_info t
         where t.id = #{id}
    </select>


    <update id="deleteBaseSectionInfoById" parameterType="String">
        update base_section_info set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteBaseSectionInfoByIds" parameterType="String">
        update base_section_info set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
