<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.ZdataLocationDictMapper">

    <resultMap type="com.ruoyi.base.domain.ZdataLocationDict" id="ZdataLocationDictResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="name"    column="name"    />
        <result property="rawCode"    column="raw_code"    />
        <result property="standardCode"    column="standard_code"    />
        <result property="roadcode"    column="roadcode"    />
        <result property="roadname"    column="roadname"    />
        <result property="sectioncode"    column="sectioncode"    />
        <result property="sectionname"    column="sectionname"    />
        <result property="tollcode"    column="tollcode"    />
        <result property="tollname"    column="tollname"    />
        <result property="orgcode"    column="orgcode"    />
        <result property="orgname"    column="orgname"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />

    </resultMap>

    <sql id="selectZdataLocationDictVo">
        t.id,
        t.type,
        t.name,
        t.raw_code,
        t.standard_code,
        t.roadcode,
        t.roadname,
        t.sectioncode,
        t.sectionname,
        t.tollcode,
        t.tollname,
        t.orgcode,
        t.orgname,
        t.created_at,
        t.updated_at
    </sql>


    <select id="selectZdataLocationDictList" parameterType="com.ruoyi.base.domain.ZdataLocationDict" resultMap="ZdataLocationDictResult">
        SELECT
        <include refid="selectZdataLocationDictVo"/>
        FROM zdata_location_dict t
        WHERE 1=1
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="type != null  and type != ''"> and t.type = #{type}</if>
        <if test="name != null  and name != ''"> and t.name like concat('%', #{name}, '%')</if>
        <if test="rawCode != null  and rawCode != ''"> and t.raw_code = #{rawCode}</if>
        <if test="standardCode != null  and standardCode != ''"> and t.standard_code = #{standardCode}</if>
        <if test="roadcode != null  and roadcode != ''"> and t.roadcode = #{roadcode}</if>
        <if test="roadname != null  and roadname != ''"> and t.roadname like concat('%', #{roadname}, '%')</if>
        <if test="sectioncode != null  and sectioncode != ''"> and t.sectioncode = #{sectioncode}</if>
        <if test="sectionname != null  and sectionname != ''"> and t.sectionname like concat('%', #{sectionname}, '%')</if>
        <if test="tollcode != null  and tollcode != ''"> and t.tollcode = #{tollcode}</if>
        <if test="tollname != null  and tollname != ''"> and t.tollname like concat('%', #{tollname}, '%')</if>
        <if test="orgcode != null  and orgcode != ''"> and t.orgcode = #{orgcode}</if>
        <if test="orgname != null  and orgname != ''"> and t.orgname like concat('%', #{orgname}, '%')</if>
        <if test="createdAt != null "> and t.created_at = #{createdAt}</if>
        <if test="updatedAt != null "> and t.updated_at = #{updatedAt}</if>
    </select>

    <select id="selectZdataLocationDictById" parameterType="Long" resultMap="ZdataLocationDictResult">
         select
         <include refid="selectZdataLocationDictVo"/>
         from zdata_location_dict t
         where t.id = #{id}
    </select>


    <update id="deleteZdataLocationDictById" parameterType="Long">
        update zdata_location_dict set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteZdataLocationDictByIds" parameterType="String">
        update zdata_location_dict set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
