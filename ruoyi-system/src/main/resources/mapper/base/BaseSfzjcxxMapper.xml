    <select id="selectBaseSfzjcxxById" parameterType="String" resultMap="BaseSfzjcxxResult">
         select
         <include refid="selectBaseSfzjcxxVo"/>
         from base_sfzjcxx t
         where t.agent_pk = #{agentPk}
    </select>


    <update id="deleteBaseSfzjcxxById" parameterType="String">
        update base_sfzjcxx set del_flag = '1' where agent_pk = #{agentPk}
    </update>

    <update id="deleteBaseSfzjcxxByIds" parameterType="String">
        update base_sfzjcxx set del_flag = '1' where agent_pk in
        <foreach item="agentPk" collection="array" open="(" separator="," close=")">
            #{agentPk}
        </foreach>
    </update>
