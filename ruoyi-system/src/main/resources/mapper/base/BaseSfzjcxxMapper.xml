    <select id="selectBaseSfzjcxxList" parameterType="com.ruoyi.base.domain.BaseSfzjcxx" resultMap="BaseSfzjcxxResult">
        SELECT
        <include refid="selectBaseSfzjcxxVo"/>
        FROM base_sfzjcxx t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="yxtzj != null  and yxtzj != ''"> and t.yxtzj = #{yxtzj}</if>
        <if test="sfzdm != null  and sfzdm != ''"> and t.sfzdm = #{sfzdm}</if>
