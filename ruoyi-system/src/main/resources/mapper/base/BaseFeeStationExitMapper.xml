    <select id="selectBaseFeeStationExitList" parameterType="com.ruoyi.base.domain.BaseFeeStationExit" resultMap="BaseFeeStationExitResult">
        SELECT
        <include refid="selectBaseFeeStationExitVo"/>
        FROM base_fee_station_exit t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="actualFeeClass != null  and actualFeeClass != ''"> and t.actual_fee_class = #{actualFeeClass}</if>
        <if test="axleCount != null "> and t.axle_count = #{axleCount}</if>
