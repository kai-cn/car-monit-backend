    <select id="selectBaseFeeStationExitById" parameterType="String" resultMap="BaseFeeStationExitResult">
         select
         <include refid="selectBaseFeeStationExitVo"/>
         from base_fee_station_exit t
         where t.big_id = #{bigId}
    </select>


    <update id="deleteBaseFeeStationExitById" parameterType="String">
        update base_fee_station_exit set del_flag = '1' where big_id = #{bigId}
    </update>

    <update id="deleteBaseFeeStationExitByIds" parameterType="String">
        update base_fee_station_exit set del_flag = '1' where big_id in
        <foreach item="bigId" collection="array" open="(" separator="," close=")">
            #{bigId}
        </foreach>
    </update>
