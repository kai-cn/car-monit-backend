<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.OdsSzdnTollStationIpMapper">

    <resultMap type="com.ruoyi.base.domain.OdsSzdnTollStationIp" id="OdsSzdnTollStationIpResult">
        <result property="id"    column="id"    />
        <result property="tollCode"    column="toll_code"    />
        <result property="tollName"    column="toll_name"    />
        <result property="orgCode"    column="org_code"    />
        <result property="ip"    column="ip"    />
        <result property="brand"    column="brand"    />

    </resultMap>

    <sql id="selectOdsSzdnTollStationIpVo">
        t.id,
        t.toll_code,
        t.toll_name,
        t.org_code,
        t.ip,
        t.brand
    </sql>


    <select id="selectOdsSzdnTollStationIpList" parameterType="com.ruoyi.base.domain.OdsSzdnTollStationIp" resultMap="OdsSzdnTollStationIpResult">
        SELECT
        <include refid="selectOdsSzdnTollStationIpVo"/>
        FROM ods_szdn_toll_station_ip t
        WHERE 1 = 1
        <if test="tollCode != null  and tollCode != ''"> and t.toll_code = #{tollCode}</if>
        <if test="tollName != null  and tollName != ''"> and t.toll_name like concat('%', #{tollName}, '%')</if>
        <if test="orgCode != null  and orgCode != ''"> and t.org_code = #{orgCode}</if>
        <if test="ip != null  and ip != ''"> and t.ip = #{ip}</if>
        <if test="brand != null  and brand != ''"> and t.brand = #{brand}</if>
        order by t.big_id
    </select>

    <select id="selectOdsSzdnTollStationIpById" parameterType="Long" resultMap="OdsSzdnTollStationIpResult">
         select
         <include refid="selectOdsSzdnTollStationIpVo"/>
         from ods_szdn_toll_station_ip t
         where t.id = #{id}
    </select>


</mapper>
