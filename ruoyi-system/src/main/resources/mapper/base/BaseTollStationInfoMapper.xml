<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.BaseTollStationInfoMapper">

    <resultMap type="com.ruoyi.base.domain.BaseTollStationInfo" id="BaseTollStationInfoResult">
        <result property="id"    column="id"    />
        <result property="roadCode"    column="road_code"    />
        <result property="idCard"    column="id_card"    />
        <result property="tollCode"    column="toll_code"    />
        <result property="tollName"    column="toll_name"    />
        <result property="pileNo"    column="pile_no"    />
        <result property="orgName"    column="org_name"    />
        <result property="hexCode"    column="hex_code"    />
        <result property="stateCode"    column="state_code"    />
        <result property="orgCode"    column="org_code"    />
        <result property="longitude"    column="longitude"    />
        <result property="latitude"    column="latitude"    />
        <result property="openDate"    column="open_date"    />
        <result property="tollAliasName"    column="toll_alias_name"    />
        <result property="inMonitorResource"    column="in_monitor_resource"    />
        <result property="laneMonitorResource"    column="lane_monitor_resource"    />
        <result property="squareMonitorResource"    column="square_monitor_resource"    />
        <result property="dynamicMonitorResource"    column="dynamic_monitor_resource"    />
        <result property="tollCodeMerge"    column="toll_code_merge"    />
        <result property="stateCodeMerge"    column="state_code_merge"    />
        <result property="tollNameMerge"    column="toll_name_merge"    />
        <result property="sectionCode"    column="section_code"    />
        <result property="tollOrgCode"    column="toll_org_code"    />
        <result property="isAccess"    column="is_access"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectBaseTollStationInfoVo">
        t.id,
        t.road_code,
        t.id_card,
        t.toll_code,
        t.toll_name,
        t.pile_no,
        t.org_name,
        t.hex_code,
        t.state_code,
        t.org_code,
        t.longitude,
        t.latitude,
        t.open_date,
        t.toll_alias_name,
        t.in_monitor_resource,
        t.lane_monitor_resource,
        t.square_monitor_resource,
        t.dynamic_monitor_resource,
        t.toll_code_merge,
        t.state_code_merge,
        t.toll_name_merge,
        t.section_code,
        t.toll_org_code,
        t.is_access,
        t.back_col1,
        t.back_col2,
        t.remark,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectBaseTollStationInfoList" parameterType="com.ruoyi.base.domain.BaseTollStationInfo" resultMap="BaseTollStationInfoResult">
        SELECT
        <include refid="selectBaseTollStationInfoVo"/>
        FROM base_toll_station_info t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="roadCode != null  and roadCode != ''"> and t.road_code = #{roadCode}</if>
        <if test="idCard != null  and idCard != ''"> and t.id_card = #{idCard}</if>
        <if test="tollCode != null  and tollCode != ''"> and t.toll_code = #{tollCode}</if>
        <if test="tollName != null  and tollName != ''"> and t.toll_name like concat('%', #{tollName}, '%')</if>
        <if test="pileNo != null  and pileNo != ''"> and t.pile_no = #{pileNo}</if>
        <if test="orgName != null  and orgName != ''"> and t.org_name like concat('%', #{orgName}, '%')</if>
        <if test="hexCode != null  and hexCode != ''"> and t.hex_code = #{hexCode}</if>
        <if test="stateCode != null  and stateCode != ''"> and t.state_code = #{stateCode}</if>
        <if test="orgCode != null  and orgCode != ''"> and t.org_code = #{orgCode}</if>
        <if test="longitude != null  and longitude != ''"> and t.longitude = #{longitude}</if>
        <if test="latitude != null  and latitude != ''"> and t.latitude = #{latitude}</if>
        <if test="openDate != null "> and t.open_date = #{openDate}</if>
        <if test="tollAliasName != null  and tollAliasName != ''"> and t.toll_alias_name like concat('%', #{tollAliasName}, '%')</if>
        <if test="inMonitorResource != null  and inMonitorResource != ''"> and t.in_monitor_resource = #{inMonitorResource}</if>
        <if test="laneMonitorResource != null  and laneMonitorResource != ''"> and t.lane_monitor_resource = #{laneMonitorResource}</if>
        <if test="squareMonitorResource != null  and squareMonitorResource != ''"> and t.square_monitor_resource = #{squareMonitorResource}</if>
        <if test="dynamicMonitorResource != null  and dynamicMonitorResource != ''"> and t.dynamic_monitor_resource = #{dynamicMonitorResource}</if>
        <if test="tollCodeMerge != null  and tollCodeMerge != ''"> and t.toll_code_merge = #{tollCodeMerge}</if>
        <if test="stateCodeMerge != null  and stateCodeMerge != ''"> and t.state_code_merge = #{stateCodeMerge}</if>
        <if test="tollNameMerge != null  and tollNameMerge != ''"> and t.toll_name_merge = #{tollNameMerge}</if>
        <if test="sectionCode != null  and sectionCode != ''"> and t.section_code = #{sectionCode}</if>
        <if test="tollOrgCode != null  and tollOrgCode != ''"> and t.toll_org_code = #{tollOrgCode}</if>
        <if test="isAccess != null  and isAccess != ''"> and t.is_access = #{isAccess}</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectBaseTollStationInfoById" parameterType="String" resultMap="BaseTollStationInfoResult">
         select
         <include refid="selectBaseTollStationInfoVo"/>
         from base_toll_station_info t
         where t.id = #{id}
    </select>


    <update id="deleteBaseTollStationInfoById" parameterType="String">
        update base_toll_station_info set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteBaseTollStationInfoByIds" parameterType="String">
        update base_toll_station_info set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
