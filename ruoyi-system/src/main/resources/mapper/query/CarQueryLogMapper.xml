<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.query.mapper.CarQueryLogMapper">

    <resultMap type="com.ruoyi.query.domain.CarQueryLog" id="CarQueryLogResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="userIp"    column="user_ip"    />
        <result property="modelType"    column="model_type"    />
        <result property="menuPoint"    column="menu_point"    />
        <result property="queryCondition"    column="query_condition"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectCarQueryLogVo">
        t.id,
        t.user_id,
        t.user_name,
        t.user_ip,
        t.model_type,
        t.menu_point,
        t.query_condition,
        t.back_col1,
        t.back_col2,
        t.remark,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectCarQueryLogList" parameterType="com.ruoyi.query.domain.CarQueryLog" resultMap="CarQueryLogResult">
        SELECT
        <include refid="selectCarQueryLogVo"/>
        FROM car_query_log t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="userId != null  and userId != ''"> and t.user_id = #{userId}</if>
        <if test="userName != null  and userName != ''"> and t.user_name like concat('%', #{userName}, '%')</if>
        <if test="userIp != null  and userIp != ''"> and t.user_ip = #{userIp}</if>
        <if test="modelType != null  and modelType != ''"> and t.model_type = #{modelType}</if>
        <if test="menuPoint != null  and menuPoint != ''"> and t.menu_point = #{menuPoint}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectCarQueryLogById" parameterType="String" resultMap="CarQueryLogResult">
         select
         <include refid="selectCarQueryLogVo"/>
         from car_query_log t
         where t.id = #{id}
    </select>


    <update id="deleteCarQueryLogById" parameterType="String">
        update car_query_log set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteCarQueryLogByIds" parameterType="String">
        update car_query_log set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
