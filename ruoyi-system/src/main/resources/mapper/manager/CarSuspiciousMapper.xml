<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.manager.mapper.CarSuspiciousMapper">

    <resultMap type="com.ruoyi.manager.domain.CarSuspicious" id="CarSuspiciousResult">
        <result property="id"    column="id"    />
        <result property="carNo"    column="car_no"    />
        <result property="carType"    column="car_type"    />
        <result property="carVehicle"    column="car_vehicle"    />
        <result property="carNum"    column="car_num"    />
        <result property="inStationId"    column="in_station_id"    />
        <result property="inStation"    column="in_station"    />
        <result property="inTime"    column="in_time"    />
        <result property="gantryStationId"    column="gantry_station_id"    />
        <result property="gantrytStation"    column="gantryt_station"    />
        <result property="gantryTime"    column="gantry_time"    />
        <result property="fileIds"    column="file_ids"    />
        <result property="escapedType"    column="escaped_type"    />
        <result property="escapedTypeName"    column="escaped_type_name"    />
        <result property="isExcept"    column="is_except"    />
        <result property="orgId"    column="org_id"    />
        <result property="orgName"    column="org_name"    />
        <result property="isWhite"    column="is_white"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="whiteRemark"    column="white_remark"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectCarSuspiciousVo">
        t.id,
        t.car_no,
        t.car_type,
        t.car_vehicle,
        t.car_num,
        t.in_station_id,
        t.in_station,
        t.in_time,
        t.gantry_station_id,
        t.gantryt_station,
        t.gantry_time,
        t.file_ids,
        t.escaped_type,
        t.escaped_type_name,
        t.is_except,
        t.org_id,
        t.org_name,
        t.is_white,
        t.back_col1,
        t.white_remark,
        t.back_col2,
        t.remark,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectCarSuspiciousList" parameterType="com.ruoyi.manager.domain.CarSuspicious" resultMap="CarSuspiciousResult">
        SELECT
        <include refid="selectCarSuspiciousVo"/>
        FROM car_suspicious t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="carNo != null  and carNo != ''"> and t.car_no = #{carNo}</if>
        <if test="carType != null  and carType != ''"> and t.car_type = #{carType}</if>
        <if test="carVehicle != null  and carVehicle != ''"> and t.car_vehicle = #{carVehicle}</if>
        <if test="carNum != null "> and t.car_num = #{carNum}</if>
        <if test="inStationId != null  and inStationId != ''"> and t.in_station_id = #{inStationId}</if>
        <if test="inStation != null  and inStation != ''"> and t.in_station = #{inStation}</if>
        <if test="inTime != null "> and t.in_time = #{inTime}</if>
        <if test="gantryStationId != null  and gantryStationId != ''"> and t.gantry_station_id = #{gantryStationId}</if>
        <if test="gantrytStation != null  and gantrytStation != ''"> and t.gantryt_station = #{gantrytStation}</if>
        <if test="gantryTime != null "> and t.gantry_time = #{gantryTime}</if>
        <if test="fileIds != null  and fileIds != ''"> and t.file_ids = #{fileIds}</if>
        <if test="escapedType != null  and escapedType != ''"> and t.escaped_type = #{escapedType}</if>
        <if test="escapedTypeName != null  and escapedTypeName != ''"> and t.escaped_type_name like concat('%', #{escapedTypeName}, '%')</if>
        <if test="isExcept != null  and isExcept != ''"> and t.is_except = #{isExcept}</if>
        <if test="orgId != null  and orgId != ''"> and t.org_id = #{orgId}</if>
        <if test="orgName != null  and orgName != ''"> and t.org_name like concat('%', #{orgName}, '%')</if>
        <if test="isWhite != null  and isWhite != ''"> and t.is_white = #{isWhite}</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="whiteRemark != null  and whiteRemark != ''"> and t.white_remark = #{whiteRemark}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        <if test="applyTime1 != null  and applyTime1 != ''">and t.create_time >= STR_TO_DATE(#{applyTime1},'%Y-%m-%d')</if>
        <if test="applyTime2 != null  and applyTime2 != ''">and t.create_time <![CDATA[<]]> date_add(STR_TO_DATE(#{applyTime2},'%Y-%m-%d'), interval 1 day) </if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectCarSuspiciousById" parameterType="String" resultMap="CarSuspiciousResult">
        select
        <include refid="selectCarSuspiciousVo"/>
        from car_suspicious t
        where t.id = #{id}
    </select>


    <update id="deleteCarSuspiciousById" parameterType="String">
        update car_suspicious set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteCarSuspiciousByIds" parameterType="String">
        update car_suspicious set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
