    <resultMap type="com.ruoyi.manager.domain.CarSuspicious" id="CarSuspiciousResult">
        <result property="id"    column="id"    />
        <result property="plateColor"    column="plate_color"    />
        <result property="carNo"    column="car_no"    />
        <result property="carType"    column="car_type"    />
        <result property="carVehicle"    column="car_vehicle"    />
        <result property="carNum"    column="car_num"    />
        <result property="passType"    column="pass_type"    />
        <result property="inStationId"    column="in_station_id"    />
        <result property="inStation"    column="in_station"    />
        <result property="inTime"    column="in_time"    />
        <result property="outStationId"    column="out_station_id"    />
        <result property="outStation"    column="out_station"    />
        <result property="outTime"    column="out_time"    />
        <result property="gantryStationId"    column="gantry_station_id"    />
        <result property="gantrytStation"    column="gantryt_station"    />
        <result property="gantryTime"    column="gantry_time"    />
        <result property="fileIds"    column="file_ids"    />
        <result property="outGantryStationId"    column="out_gantry_station_id"    />
        <result property="outGantrytStation"    column="out_gantryt_station"    />
        <result property="outGantryTime"    column="out_gantry_time"    />
        <result property="outFileIds"    column="out_file_ids"    />
        <result property="escapedType"    column="escaped_type"    />
        <result property="escapedTypeName"    column="escaped_type_name"    />
        <result property="escapedNum"    column="escaped_num"    />
        <result property="isExcept"    column="is_except"    />
        <result property="exceptRemark"    column="except_remark"    />
        <result property="exceptFileIds"    column="except_file_ids"    />
        <result property="checkStatus"    column="check_status"    />
        <result property="orgId"    column="org_id"    />
        <result property="orgName"    column="org_name"    />
        <result property="isWhite"    column="is_white"    />
        <result property="whiteRemark"    column="white_remark"    />
        <result property="whiteFileIds"    column="white_file_ids"    />
        <result property="roadCode"    column="road_code"    />
        <result property="roadName"    column="road_name"    />
        <result property="sectionCode"    column="section_code"    />
        <result property="sectionName"    column="section_name"    />
        <result property="trackId"    column="track_id"    />
