<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.manager.mapper.CarAduitFreeMapper">

    <resultMap type="com.ruoyi.manager.domain.CarAduitFree" id="CarAduitFreeResult">
        <result property="id"    column="id"    />
        <result property="confirmId"    column="confirm_id"    />
        <result property="carId"    column="car_id"    />
        <result property="carNo"    column="car_no"    />
        <result property="carType"    column="car_type"    />
        <result property="carVehicle"    column="car_vehicle"    />
        <result property="orgId"    column="org_id"    />
        <result property="orgName"    column="org_name"    />
        <result property="userIds"    column="user_ids"    />
        <result property="userNames"    column="user_names"    />
        <result property="amount"    column="amount"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectCarAduitFreeVo">
        t.id,
        t.confirm_id,
        t.car_id,
        t.car_no,
        t.car_type,
        t.car_vehicle,
        t.org_id,
        t.org_name,
        t.user_ids,
        t.user_names,
        t.amount,
        t.back_col1,
        t.back_col2,
        t.remark,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectCarAduitFreeList" parameterType="com.ruoyi.manager.domain.CarAduitFree" resultMap="CarAduitFreeResult">
        SELECT
        <include refid="selectCarAduitFreeVo"/>
        FROM car_aduit_free t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="confirmId != null  and confirmId != ''"> and t.confirm_id = #{confirmId}</if>
        <if test="carId != null  and carId != ''"> and t.car_id = #{carId}</if>
        <if test="carNo != null  and carNo != ''"> and t.car_no = #{carNo}</if>
        <if test="carType != null  and carType != ''"> and t.car_type = #{carType}</if>
        <if test="carVehicle != null  and carVehicle != ''"> and t.car_vehicle = #{carVehicle}</if>
        <if test="orgId != null  and orgId != ''"> and t.org_id = #{orgId}</if>
        <if test="orgName != null  and orgName != ''"> and t.org_name like concat('%', #{orgName}, '%')</if>
        <if test="userIds != null  and userIds != ''"> and t.user_ids = #{userIds}</if>
        <if test="userNames != null  and userNames != ''"> and t.user_names = #{userNames}</if>
        <if test="amount != null "> and t.amount = #{amount}</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectCarAduitFreeById" parameterType="String" resultMap="CarAduitFreeResult">
         select
         <include refid="selectCarAduitFreeVo"/>
         from car_aduit_free t
         where t.id = #{id}
    </select>

    <select id="getCarAudit" resultType="java.math.BigDecimal">
        select sum(ifnull(amount, 0)) totalAmount from car_aduit_free where del_flag = '0';
    </select>

    <select id="incomeStatistic" parameterType="com.ruoyi.manager.domain.vo.bigscreen.IncomeStatisticParam" resultType="com.ruoyi.manager.domain.vo.bigscreen.incomeStatisticVO">
        select sum(amount) amount, count(distinct car_id) carNum, a.org_name
        from car_aduit_free a
                 left join ods_yhgl_v_base_org o on a.org_id = o.org_code
        <where>
            a.del_flag = '0'
            <if test="orgCode != null  and orgCode != ''"> and a.org_id = #{orgCode}</if>
            <if test="startDate != null  and startDate != ''">and a.create_time >= STR_TO_DATE(#{startDate},'%Y-%m-%d') and a.create_time <![CDATA[<]]> LAST_DAY(#{startDate})</if>
            <if test="queryDateType != null  and queryDateType == '1'">and a.create_time BETWEEN CONCAT(YEAR(CURDATE()), '-01-01') AND CURDATE()</if>
            <if test="queryDateType != null  and queryDateType == '2'"> and a.create_time BETWEEN CONCAT(YEAR(CURDATE()), '-', LPAD(MONTH(CURDATE()), 2, '0'), '-01') AND CURDATE()</if>
        </where>
        group by a.org_id;
    </select>

    <select id="selectAuditCount" resultType="java.lang.Integer">
        select count(distinct confirm_id) confirmCount from car_aduit_free where del_flag = '0';
    </select>


    <update id="deleteCarAduitFreeById" parameterType="String">
        update car_aduit_free set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteCarAduitFreeByIds" parameterType="String">
        update car_aduit_free set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
