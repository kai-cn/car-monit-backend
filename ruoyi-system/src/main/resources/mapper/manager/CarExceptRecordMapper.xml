<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.manager.mapper.CarExceptRecordMapper">

    <resultMap type="com.ruoyi.manager.domain.CarExceptRecord" id="CarExceptRecordResult">
        <result property="id"    column="id"    />
        <result property="carId"    column="car_id"    />
        <result property="carNo"    column="car_no"    />
        <result property="carType"    column="car_type"    />
        <result property="carVehicle"    column="car_vehicle"    />
        <result property="carNum"    column="car_num"    />
        <result property="passType"    column="pass_type"    />
        <result property="inStationId"    column="in_station_id"    />
        <result property="inStation"    column="in_station"    />
        <result property="inTime"    column="in_time"    />
        <result property="outStationId"    column="out_station_id"    />
        <result property="outStation"    column="out_station"    />
        <result property="outTime"    column="out_time"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="chargeAmount"    column="charge_amount"    />
        <result property="difAmount"    column="dif_amount"    />
        <result property="escapedType"    column="escaped_type"    />
        <result property="remark"    column="remark"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectCarExceptRecordVo">
        t.id,
        t.car_id,
        t.car_no,
        t.car_type,
        t.car_vehicle,
        t.car_num,
        t.pass_type,
        t.in_station_id,
        t.in_station,
        t.in_time,
        t.out_station_id,
        t.out_station,
        t.out_time,
        t.total_amount,
        t.charge_amount,
        t.dif_amount,
        t.escaped_type,
        t.remark,
        t.back_col1,
        t.back_col2,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectCarExceptRecordList" parameterType="com.ruoyi.manager.domain.CarExceptRecord" resultMap="CarExceptRecordResult">
        SELECT
        <include refid="selectCarExceptRecordVo"/>
        FROM car_except_record t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="carId != null  and carId != ''"> and t.car_id = #{carId}</if>
        <if test="carNo != null  and carNo != ''"> and t.car_no like concat('%', #{carNo}, '%')</if>
        <if test="carType != null  and carType != ''"> and t.car_type = #{carType}</if>
        <if test="carVehicle != null  and carVehicle != ''"> and t.car_vehicle = #{carVehicle}</if>
        <if test="carNum != null "> and t.car_num = #{carNum}</if>
        <if test="passType != null  and passType != ''"> and t.pass_type = #{passType}</if>
        <if test="inStationId != null  and inStationId != ''"> and t.in_station_id = #{inStationId}</if>
        <if test="inStation != null  and inStation != ''"> and t.in_station like concat('%', #{inStation}, '%')</if>
        <if test="inTime != null "> and t.in_time = #{inTime}</if>
        <if test="outStationId != null  and outStationId != ''"> and t.out_station_id = #{outStationId}</if>
        <if test="outStation != null  and outStation != ''"> and t.out_station like concat('%', #{outStation}, '%')</if>
        <if test="outTime != null "> and t.out_time = #{outTime}</if>
        <if test="totalAmount != null "> and t.total_amount = #{totalAmount}</if>
        <if test="chargeAmount != null "> and t.charge_amount = #{chargeAmount}</if>
        <if test="difAmount != null "> and t.dif_amount = #{difAmount}</if>
        <if test="escapedType != null  and escapedType != ''"> and t.escaped_type = #{escapedType}</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        <if test="applyTime1 != null  and applyTime1 != ''">and t.create_time >= STR_TO_DATE(#{applyTime1},'%Y-%m-%d')</if>
        <if test="applyTime2 != null  and applyTime2 != ''">and t.create_time <![CDATA[<]]> date_add(STR_TO_DATE(#{applyTime2},'%Y-%m-%d'), interval 1 day) </if>
        <if test="exceptIds != null  and exceptIds != ''"> and find_in_set(t.id,#{exceptIds}) > 0 </if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectCarExceptRecordById" parameterType="String" resultMap="CarExceptRecordResult">
         select
         <include refid="selectCarExceptRecordVo"/>
         from car_except_record t
         where t.id = #{id}
    </select>


    <update id="deleteCarExceptRecordById" parameterType="String">
        update car_except_record set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteCarExceptRecordByIds" parameterType="String">
        update car_except_record set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
    <update id="updateStatusByExceptId">
        update car_except_record set status = #{status} where id in
        <foreach item="id" collection="exceptIdList" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
