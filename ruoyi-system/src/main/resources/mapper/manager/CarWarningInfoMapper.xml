<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.manager.mapper.CarWarningInfoMapper">

    <resultMap type="com.ruoyi.manager.domain.CarWarningInfo" id="CarWarningInfoResult">
        <result property="id"    column="id"    />
        <result property="carId"    column="car_id"    />
        <result property="carNo"    column="car_no"    />
        <result property="carType"    column="car_type"    />
        <result property="carVehicle"    column="car_vehicle"    />
        <result property="carNum"    column="car_num"    />
        <result property="inStationId"    column="in_station_id"    />
        <result property="inStation"    column="in_station"    />
        <result property="inTime"    column="in_time"    />
        <result property="gantryStationId"    column="gantry_station_id"    />
        <result property="gantrytStation"    column="gantryt_station"    />
        <result property="gantryTime"    column="gantry_time"    />
        <result property="fileIds"    column="file_ids"    />
        <result property="nextPassTime"    column="next_pass_time"    />
        <result property="nextPassType"    column="next_pass_type"    />
        <result property="nextPassAddress"    column="next_pass_address"    />
        <result property="nextPassLongitude"    column="next_pass_longitude"    />
        <result property="nextPassLatitude"    column="next_pass_latitude"    />
        <result property="roadCode"    column="road_code"    />
        <result property="roadName"    column="road_name"    />
        <result property="sectionCode"    column="section_code"    />
        <result property="sectionName"    column="section_name"    />
        <result property="trackId"    column="track_id"    />
        <result property="trackJosn"    column="track_josn"    />
        <result property="trackNames"    column="track_names"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectCarWarningInfoVo">
        t.id,
        t.car_id,
        t.car_no,
        t.car_type,
        t.car_vehicle,
        t.car_num,
        t.in_station_id,
        t.in_station,
        t.in_time,
        t.gantry_station_id,
        t.gantryt_station,
        t.gantry_time,
        t.file_ids,
        t.next_pass_time,
        t.next_pass_type,
        t.next_pass_address,
        t.next_pass_longitude,
        t.next_pass_latitude,
        t.road_code,
        t.road_name,
        t.section_code,
        t.section_name,
        t.back_col1,
        t.back_col2,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id,
        t.track_id,
        t.track_names
    </sql>



    <select id="selectCarWarningInfoList" parameterType="com.ruoyi.manager.domain.CarWarningInfo" resultMap="CarWarningInfoResult">
        SELECT
        <include refid="selectCarWarningInfoVo"/>, c.escaped_type escapedType, c.escaped_amount escapedAmount
        FROM car_warning_info t
        inner join car_info c on t.car_id = c.id
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="carId != null  and carId != ''"> and t.car_id = #{carId}</if>
        <if test="carNo != null  and carNo != ''"> and t.car_no like concat('%', #{carNo}, '%')</if>
        <if test="carType != null  and carType != ''"> and t.car_type = #{carType}</if>
        <if test="carVehicle != null  and carVehicle != ''"> and t.car_vehicle = #{carVehicle}</if>
        <if test="carNum != null "> and t.car_num = #{carNum}</if>
        <if test="inStationId != null  and inStationId != ''"> and t.in_station_id = #{inStationId}</if>
        <if test="inStation != null  and inStation != ''"> and t.in_station = #{inStation}</if>
        <if test="inTime != null "> and t.in_time = #{inTime}</if>
        <if test="gantryStationId != null  and gantryStationId != ''"> and t.gantry_station_id = #{gantryStationId}</if>
        <if test="gantrytStation != null  and gantrytStation != ''"> and t.gantryt_station like concat('%', #{gantrytStation}, '%')</if>
        <if test="gantryTime != null "> and t.gantry_time = #{gantryTime}</if>
        <if test="fileIds != null  and fileIds != ''"> and t.file_ids = #{fileIds}</if>
        <if test="nextPassTime != null "> and t.next_pass_time = #{nextPassTime}</if>
        <if test="nextPassType != null  and nextPassType != ''"> and t.next_pass_type = #{nextPassType}</if>
        <if test="nextPassAddress != null  and nextPassAddress != ''"> and t.next_pass_address = #{nextPassAddress}</if>
        <if test="nextPassLongitude != null  and nextPassLongitude != ''"> and t.next_pass_longitude = #{nextPassLongitude}</if>
        <if test="nextPassLatitude != null  and nextPassLatitude != ''"> and t.next_pass_latitude = #{nextPassLatitude}</if>
        <if test="roadCode != null  and roadCode != ''"> and t.track_names like concat('%', #{roadCode}, '%')</if>
        <if test="roadName != null  and roadName != ''"> and t.road_name like concat('%', #{roadName}, '%')</if>
        <if test="sectionCode != null  and sectionCode != ''"> and t.section_code = #{sectionCode}</if>
        <if test="sectionName != null  and sectionName != ''"> and t.section_name like concat('%', #{sectionName}, '%')</if>
        <if test="trackId != null  and trackId != ''"> and t.track_id = #{trackId}</if>
        <if test="trackJosn != null  and trackJosn != ''"> and t.track_josn = #{trackJosn}</if>
        <if test="trackNames != null  and trackNames != ''"> and t.track_names like concat('%', #{trackNames}, '%')</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>

        <if test="applyTime1 != null  and applyTime1 != ''">and t.in_time >= STR_TO_DATE(#{applyTime1},'%Y-%m-%d %H:%i:%s')</if>
        <if test="applyTime2 != null  and applyTime2 != ''">and t.in_time <![CDATA[<=]]> STR_TO_DATE(#{applyTime2},'%Y-%m-%d %H:%i:%s') </if>
        <if test="carNoQuery != null  and carNoQuery != ''"> and t.car_no like concat('%', #{carNoQuery}, '%')</if>

        <!--当前在线轨迹-->
        <if test="flag != null and flag == 'curDate' ">
            and c.status = '1' and t.back_col1 = #{flagTime}
        </if>

        <!--历史轨迹-->
        <if test="flag != null and flag == 'histhory' ">
            and t.back_col1 != #{flagTime}
        </if>

        order by t.gantry_time desc,t.id
    </select>

    <select id="selectCarWarningInfoById" parameterType="String" resultMap="CarWarningInfoResult">
         select
         <include refid="selectCarWarningInfoVo"/>,t.track_josn
         from car_warning_info t
         where t.id = #{id}
    </select>

    <select id="selectCarWarningInfoListLimit100" parameterType="com.ruoyi.manager.domain.CarWarningInfo" resultMap="CarWarningInfoResult">
        SELECT
        <include refid="selectCarWarningInfoVo"/>, c.escaped_type escapedType, c.escaped_amount escapedAmount
        FROM car_warning_info t
        inner join car_info c on c.del_flag = '0' and  t.car_id = c.id and c.status = '1'
        WHERE t.del_flag = '0' and  t.back_col1 = #{trackId}
        order by t.gantry_time desc,t.id
    </select>


    <update id="deleteCarWarningInfoById" parameterType="String">
        update car_warning_info set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteCarWarningInfoByIds" parameterType="String">
        update car_warning_info set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>


    <delete id="deleteCarWarningInfoByUUid">
        delete from car_warning_info where track_id in
        <foreach item="id" collection="idList" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>



</mapper>
