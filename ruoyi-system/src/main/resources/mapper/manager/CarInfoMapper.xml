        t.car_no,
        t.car_type,
        t.car_vehicle,
        t.car_num,
        t.escaped_type,
        t.escaped_type_name,
        t.escaped_amount,
        t.escaped_num,
        t.return_amount,
        t.total_amount,
        t.charge_amount,
        t.dif_amount,
        t.auit_org_id,
        t.auit_org_name,
        t.is_white,
        t.white_remark,
        t.file_ids,
        t.brand,
        t.plate_color,
        t.plate_type,
        t.car_color,
        t.data_source,
        t.data_source_name,
        t.last_pass_time,
        t.last_pass_picture,
        t.last_pass_type,
        t.last_pass_address,
        t.last_pass_longitude,
        t.last_pass_latitude,
        t.last_pass_cardirection,
        t.road_section_id,
        t.section_code,
        t.road_section_name,
        t.next_pass_time,
        t.next_pass_type,
        t.next_pass_address,
        t.next_pass_longitude,
        t.next_pass_latitude,
        t.track_id,
        t.org_id,
