    <select id="selectCarInfoList" parameterType="com.ruoyi.manager.domain.CarInfo" resultMap="CarInfoResult">
        SELECT
        <include refid="selectCarInfoVo"/>,concat(sd.dept_name, ' ', su.nick_name) createInfo
        FROM car_info t
        left join sys_user su on su.user_id = t.create_by
        left join sys_dept sd on t.eps_id = sd.dept_id
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="carNo != null  and carNo != ''"> and t.car_no = #{carNo}</if>
        <if test="carType != null  and carType != ''"> and t.car_type = #{carType}</if>
        <if test="carVehicle != null  and carVehicle != ''"> and t.car_vehicle = #{carVehicle}</if>
        <if test="carNum != null "> and t.car_num = #{carNum}</if>
        <if test="escapedType != null  and escapedType != ''"> and t.escaped_type like concat('%', #{escapedType}, '%') </if>
        <if test="escapedTypeName != null  and escapedTypeName != ''"> and t.escaped_type_name like concat('%', #{escapedTypeName}, '%')</if>
        <if test="escapedAmount != null "> and t.escaped_amount = #{escapedAmount}</if>
        <if test="escapedNum != null "> and t.escaped_num = #{escapedNum}</if>
        <if test="returnAmount != null "> and t.return_amount = #{returnAmount}</if>
        <if test="totalAmount != null "> and t.total_amount = #{totalAmount}</if>
        <if test="chargeAmount != null "> and t.charge_amount = #{chargeAmount}</if>
        <if test="difAmount != null "> and t.dif_amount = #{difAmount}</if>
        <if test="auitOrgId != null  and auitOrgId != ''"> and t.auit_org_id = #{auitOrgId}</if>
        <if test="auitOrgName != null  and auitOrgName != ''"> and t.auit_org_name like concat('%', #{auitOrgName}, '%')</if>
        <if test="isWhite != null  and isWhite != ''"> and t.is_white = #{isWhite}</if>
        <if test="whiteRemark != null  and whiteRemark != ''"> and t.white_remark = #{whiteRemark}</if>
        <if test="fileIds != null  and fileIds != ''"> and t.file_ids = #{fileIds}</if>
        <if test="brand != null  and brand != ''"> and t.brand = #{brand}</if>
        <if test="plateColor != null  and plateColor != ''"> and t.plate_color = #{plateColor}</if>
        <if test="plateType != null  and plateType != ''"> and t.plate_type = #{plateType}</if>
        <if test="carColor != null  and carColor != ''"> and t.car_color = #{carColor}</if>
        <if test="dataSource != null  and dataSource != ''"> and t.data_source = #{dataSource}</if>
        <if test="dataSourceName != null  and dataSourceName != ''"> and t.data_source_name like concat('%', #{dataSourceName}, '%')</if>
        <if test="lastPassTime != null "> and t.last_pass_time = #{lastPassTime}</if>
        <if test="lastPassPicture != null  and lastPassPicture != ''"> and t.last_pass_picture = #{lastPassPicture}</if>
        <if test="lastPassType != null  and lastPassType != ''"> and t.last_pass_type = #{lastPassType}</if>
        <if test="lastPassAddress != null  and lastPassAddress != ''"> and t.last_pass_address = #{lastPassAddress}</if>
        <if test="lastPassLongitude != null  and lastPassLongitude != ''"> and t.last_pass_longitude = #{lastPassLongitude}</if>
        <if test="lastPassLatitude != null  and lastPassLatitude != ''"> and t.last_pass_latitude = #{lastPassLatitude}</if>
        <if test="lastPassCardirection != null  and lastPassCardirection != ''"> and t.last_pass_cardirection = #{lastPassCardirection}</if>
        <if test="roadSectionId != null  and roadSectionId != ''"> and t.road_section_id = #{roadSectionId}</if>
        <if test="sectionCode != null  and sectionCode != ''"> and t.section_code = #{sectionCode}</if>
        <if test="roadSectionName != null  and roadSectionName != ''"> and t.road_section_name like concat('%', #{roadSectionName}, '%')</if>
        <if test="nextPassTime != null "> and t.next_pass_time = #{nextPassTime}</if>
        <if test="nextPassType != null  and nextPassType != ''"> and t.next_pass_type = #{nextPassType}</if>
        <if test="nextPassAddress != null  and nextPassAddress != ''"> and t.next_pass_address = #{nextPassAddress}</if>
        <if test="nextPassLongitude != null  and nextPassLongitude != ''"> and t.next_pass_longitude = #{nextPassLongitude}</if>
        <if test="nextPassLatitude != null  and nextPassLatitude != ''"> and t.next_pass_latitude = #{nextPassLatitude}</if>
        <if test="orgId != null  and orgId != ''"> and t.org_id = #{orgId}</if>
        <if test="orgCode != null  and orgCode != ''"> and t.org_code = #{orgCode}</if>
        <if test="orgName != null  and orgName != ''"> and t.org_name like concat('%', #{orgName}, '%')</if>
        <if test="gantryCode != null  and gantryCode != ''"> and t.gantry_code = #{gantryCode}</if>
        <if test="roadCode != null  and roadCode != ''"> and t.road_code = #{roadCode}</if>
        <if test="roadName != null  and roadName != ''"> and t.road_name like concat('%', #{roadName}, '%')</if>
        <if test="tollCode != null  and tollCode != ''"> and t.toll_code = #{tollCode}</if>
        <if test="tollName != null  and tollName != ''"> and t.toll_name like concat('%', #{tollName}, '%')</if>
        <if test="linkName != null  and linkName != ''"> and t.link_name like concat('%', #{linkName}, '%')</if>
        <if test="linkPhone != null  and linkPhone != ''"> and t.link_phone = #{linkPhone}</if>
        <if test="fwqbm != null  and fwqbm != ''"> and t.fwqbm = #{fwqbm}</if>
        <if test="fwqmc != null  and fwqmc != ''"> and t.fwqmc = #{fwqmc}</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        <if test="carNoQuery != null  and carNoQuery != ''"> and t.car_no like concat('%', #{carNoQuery}, '%')</if>
        <if test="applyTime1 != null  and applyTime1 != ''">and t.create_time >= STR_TO_DATE(#{applyTime1},'%Y-%m-%d')</if>
        <if test="applyTime2 != null  and applyTime2 != ''">and t.create_time <![CDATA[<]]> date_add(STR_TO_DATE(#{applyTime2},'%Y-%m-%d'), interval 1 day) </if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectCarInfoById" parameterType="String" resultMap="CarInfoResult">
        select
        <include refid="selectCarInfoVo"/>,t.track_josn
        from car_info t
        where t.id = #{id}
    </select>

    <select id="getCarLocation" parameterType="com.ruoyi.manager.domain.vo.bigscreen.CarLocationParam" resultType="com.ruoyi.manager.domain.vo.bigscreen.CarLocationVO">
        select
        t.id,
        t.car_no,
        t.car_type,
        t.last_pass_longitude as lonStr,
        t.last_pass_latitude as latStr
        from car_info t
        WHERE t.del_flag = '0' and t.status = '1'
        <if test="orgCode != null  and orgCode != ''"> and t.org_code = #{orgCode}</if>
        <if test="sectionCode != null  and sectionCode != ''"> and t.section_code = #{sectionCode}</if>
        <if test="escapedType != null  and escapedType != ''"> and t.escaped_type = #{escapedType}</if>
        <if test="gantryCode != null  and gantryCode != ''"> and t.gantry_code = #{gantryCode}</if>
        <if test="roadCode != null  and roadCode != ''"> and t.road_code = #{roadCode}</if>
        <if test="tollCode != null  and tollCode != ''"> and t.toll_code = #{tollCode}</if>
        <if test="carNoQuery != null  and carNoQuery != ''"> and t.car_no like concat('%', #{carNoQuery}, '%')</if>
    </select>

    <select id="selectCarVoList" resultType="com.ruoyi.manager.domain.vo.bigscreen.CarInfoVO">
        select
        t.id,
        t.car_no,
        t.car_type,
        t.escaped_type,
        t.escaped_type_name,
        t.escaped_amount
        from car_info t
        WHERE t.del_flag = '0'
        order by t.create_time desc,t.id limit 10
    </select>


    <update id="deleteCarInfoById" parameterType="String">
        update car_info set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteCarInfoByIds" parameterType="String">
        update car_info set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 判断车俩是否存在 -->
    <select id="isExitsCar" parameterType="com.ruoyi.manager.domain.vo.bigscreen.CarInfoVO" resultType="java.lang.Integer">
        select count(1) from car_info t
        where t.del_flag = '0' and t.car_no = #{carNo}
        <if test="id != null  and id != ''"> and t.id != #{id}</if>
    </select>

</mapper>
