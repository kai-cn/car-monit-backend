<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.manager.mapper.CarConfimFreeMapper">

    <resultMap type="com.ruoyi.manager.domain.CarConfimFree" id="CarConfimFreeResult">
        <result property="id"    column="id"    />
        <result property="carId"    column="car_id"    />
        <result property="carNo"    column="car_no"    />
        <result property="carType"    column="car_type"    />
        <result property="carVehicle"    column="car_vehicle"    />
        <result property="linkName"    column="link_name"    />
        <result property="linkPhone"    column="link_phone"    />
        <result property="orgId"    column="org_id"    />
        <result property="orgName"    column="org_name"    />
        <result property="userIds"    column="user_ids"    />
        <result property="userNames"    column="user_names"    />
        <result property="amount"    column="amount"    />
        <result property="exceptIds"    column="except_ids"    />
        <result property="backCol1"    column="back_col1"    />
        <result property="backCol2"    column="back_col2"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="epsId"    column="eps_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="tenantId"    column="tenant_id"    />

    </resultMap>

    <sql id="selectCarConfimFreeVo">
        t.id,
        t.car_id,
        t.car_no,
        t.car_type,
        t.car_vehicle,
        t.link_name,
        t.link_phone,
        t.org_id,
        t.org_name,
        t.user_ids,
        t.user_names,
        t.amount,
        t.except_ids,
        t.back_col1,
        t.back_col2,
        t.remark,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectCarConfimFreeList" parameterType="com.ruoyi.manager.domain.CarConfimFree" resultMap="CarConfimFreeResult">
        SELECT
        <include refid="selectCarConfimFreeVo"/>
        FROM car_confim_free t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''"> and t.id = #{id}</if>
        <if test="carId != null  and carId != ''"> and t.car_id = #{carId}</if>
        <if test="carNo != null  and carNo != ''"> and t.car_no = #{carNo}</if>
        <if test="carType != null  and carType != ''"> and t.car_type = #{carType}</if>
        <if test="carVehicle != null  and carVehicle != ''"> and t.car_vehicle = #{carVehicle}</if>
        <if test="linkName != null  and linkName != ''"> and t.link_name like concat('%', #{linkName}, '%')</if>
        <if test="linkPhone != null  and linkPhone != ''"> and t.link_phone = #{linkPhone}</if>
        <if test="orgId != null  and orgId != ''"> and t.org_id = #{orgId}</if>
        <if test="orgName != null  and orgName != ''"> and t.org_name like concat('%', #{orgName}, '%')</if>
        <if test="userIds != null  and userIds != ''"> and t.user_ids = #{userIds}</if>
        <if test="userNames != null  and userNames != ''"> and t.user_names = #{userNames}</if>
        <if test="amount != null "> and t.amount = #{amount}</if>
        <if test="exceptIds != null  and exceptIds != ''"> and t.except_ids = #{exceptIds}</if>
        <if test="backCol1 != null  and backCol1 != ''"> and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''"> and t.back_col2 = #{backCol2}</if>
        <if test="status != null  and status != ''"> and t.status = #{status}</if>
        <if test="sort != null "> and t.sort = #{sort}</if>
        <if test="epsId != null "> and t.eps_id = #{epsId}</if>
        <if test="tenantId != null "> and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null "> and t.create_by = #{createBy}</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectCarConfimFreeById" parameterType="String" resultMap="CarConfimFreeResult">
         select
         <include refid="selectCarConfimFreeVo"/>
         from car_confim_free t
         where t.id = #{id}
    </select>

    <select id="getCarStatistics" resultType="com.ruoyi.manager.domain.vo.bigscreen.CarStatisticsVO">
        select escaped_type, sum(f.amount) escapedAmount , count(distinct car_id) number
        from car_confim_free f inner join car_info i on f.car_id = i.id
        where f.del_flag = '0'
        group by i.escaped_type;
    </select>

    <select id="getCarConfirm" resultType="java.math.BigDecimal">
        select sum(ifnull(amount, 0)) finishedAmount
        from car_confim_free f where f.del_flag = '0'
    </select>

    <select id="selectOrgId" resultType="java.lang.String">
        select org_id
        from car_confim_free where car_id = #{carId} and find_in_set(except_ids, #{id}) > 0;
    </select>


    <update id="deleteCarConfimFreeById" parameterType="String">
        update car_confim_free set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteCarConfimFreeByIds" parameterType="String">
        update car_confim_free set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
