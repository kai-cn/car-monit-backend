<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysUpgradeInfoMapper">

    <resultMap type="com.ruoyi.system.domain.SysUpgradeInfo" id="SysUpgradeInfoResult">
        <result property="id" column="id"/>
        <result property="ver" column="ver"/>
        <result property="info" column="info"/>
        <result property="backCol1" column="back_col1"/>
        <result property="epsId" column="eps_id"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="tenantId" column="tenant_id"/>
    </resultMap>

    <sql id="selectSysUpgradeInfoVo">
        t.id, t.ver, t.info, t.back_col1, t.eps_id, t.del_flag, t.create_by, t.create_time, t.update_by, t.update_time, t.tenant_id    </sql>

    <select id="selectSysUpgradeInfoList" parameterType="com.ruoyi.system.domain.SysUpgradeInfo" resultMap="SysUpgradeInfoResult">
        select
        <include refid="selectSysUpgradeInfoVo"/>
        from sys_upgrade_info t
        where t.del_flag = '0'
        <if test="id != null  and id != ''">and t.id = #{id}</if>
        <if test="ver != null  and ver != ''">and t.ver = #{ver}</if>
        <if test="info != null  and info != ''">and t.info = #{info}</if>
        <if test="backCol1 != null  and backCol1 != ''">and t.back_col1 = #{backCol1}</if>
        <if test="epsId != null ">and t.eps_id = #{epsId}</if>
        <if test="tenantId != null ">and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null ">and t.create_by = #{createBy}</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectSysUpgradeInfoById" parameterType="String" resultMap="SysUpgradeInfoResult">
        select
        <include refid="selectSysUpgradeInfoVo"/>
        from sys_upgrade_info t
        where t.id = #{id}
    </select>

    <!-- 获取最新的更新日志 -->
    <select id="selectSysUpgradeInfoNewest" resultType="com.ruoyi.system.domain.SysUpgradeInfo">
        select
        <include refid="selectSysUpgradeInfoVo"/>
        from sys_upgrade_info t
        where t.del_flag = '0'
        and t.back_col1 = 1
        ORDER BY t.UPDATE_TIME desc LIMIT 1
    </select>

    <insert id="insertSysUpgradeInfo" parameterType="com.ruoyi.system.domain.SysUpgradeInfo">
        insert into sys_upgrade_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="ver != null">ver,</if>
            <if test="info != null">info,</if>
            <if test="backCol1 != null">back_col1,</if>
            <if test="epsId != null">eps_id,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="ver != null">#{ver},</if>
            <if test="info != null">#{info},</if>
            <if test="backCol1 != null">#{backCol1},</if>
            <if test="epsId != null">#{epsId},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
        </trim>
    </insert>

    <update id="updateSysUpgradeInfo" parameterType="com.ruoyi.system.domain.SysUpgradeInfo">
        update sys_upgrade_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="ver != null">ver = #{ver},</if>
            <if test="info != null">info = #{info},</if>
            <if test="backCol1 != null">back_col1 = #{backCol1},</if>
            <if test="epsId != null">eps_id = #{epsId},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteSysUpgradeInfoById" parameterType="String">
        update sys_upgrade_info
        set del_flag = '1'
        where id = #{id}
    </update>

    <update id="deleteSysUpgradeInfoByIds" parameterType="String">
        update sys_upgrade_info set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
