<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ruoyi</artifactId>
        <groupId>com.ruoyi</groupId>
        <version>3.8.7</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>ruoyi-admin</artifactId>

    <description>
        web服务入口
    </description>

    <dependencies>

        <!-- Kafka -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Elasticsearch -->
        <dependency>
            <groupId>org.elasticsearch</groupId>
            <artifactId>elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-high-level-client</artifactId>
        </dependency>

        <!-- mybatis sql打印完整的调试 -->
        <dependency>
            <groupId>p6spy</groupId>
            <artifactId>p6spy</artifactId>
            <version>${p6spy.version}</version>
        </dependency>

        <!-- spring-boot-devtools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>provided</scope> <!-- 表示依赖不会传递 -->
        </dependency>

        <!-- OpenAPI 3 文档（springdoc；替代在 Boot 3/4 下无法启动的 springfox 3.0.0） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Mysql驱动包（Boot 4 BOM 管理 com.mysql:mysql-connector-j） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ShardingSphere 分表数据源（ShardingSphereConfig） -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-sharding-core</artifactId>
        </dependency>

        <!-- 核心模块-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-framework</artifactId>
        </dependency>

        <!-- 定时任务-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-quartz</artifactId>
        </dependency>

        <!-- 代码生成-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-generator</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <fork>true</fork> <!-- 如果没有该配置，devtools不会生效 -->
                    <mainClass>com.ruoyi.RuoYiApplication</mainClass>
                    <!-- 镜像瘦身：以下传递依赖在代码中 0 引用，且分表开关默认关闭、
                         阿里云 MNS 通道未启用，打进 fat jar 只会白白增大镜像与元空间。
                         排除后需通过实机启动 + 分页/导出接口回归确认无类缺失。 -->
                    <excludeGroupIds>org.apache.calcite,org.apache.groovy,com.aliyun.mns</excludeGroupIds>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>process-aot</id>
                        <goals>
                            <goal>process-aot</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warName>${project.artifactId}</warName>
                </configuration>
           </plugin>

            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <version>1.1.14</version>
                <configuration>
                    <mainClass>com.ruoyi.RuoYiApplication</mainClass>
                    <!-- grpc-netty-shaded 由 pulsar-client 传递引入（应用在用，不可排除）。
                         其 tcnative JNI 静态引用在 image build 期初始化会 UnsatisfiedLinkError。
                         具体类优先于包级规则，逐个显式延迟到运行时。 -->
                    <buildArgs>
                        <buildArg>-H:IncludeResources=mybatis/mybatis-config.xml</buildArg>
                        <!-- 生产镜像必须纯 native：不开 fallback，避免把整套 JVM
                             （libjvm/libawt 等）打进产物（实测未加时 342MB，
                             加后回落到 ~90MB 量级）。 -->
                        <buildArg>--no-fallback</buildArg>
                        <!-- native 下 ServiceLoader 找不到 SLF4J provider 会让 MarkerFactory 静态初始化失败 -->
                        <buildArg>-H:IncludeResources=META-INF/services/org.slf4j.spi.SLF4JServiceProvider</buildArg>
                        <!-- 迭代期用 -Ob（只做基本优化）把单次构建从 ~30min 压到 ~10min；
                             业务启动验证通过后，交付构建应去掉这一行做 -O2。 -->
                        <buildArg>-Ob</buildArg>
                        <!-- Lettuce 7（Spring Data Redis）用 FFM 的 Arena.ofShared，
                             不开启会抛 UnsupportedFeatureError 导致 Redis 连接全废。 -->
                        <buildArg>-H:+SharedArenaSupport</buildArg>
                        <!-- SLF4J/Apache Commons Logging 桥接类在 image build 期初始化会失败，延迟到运行期 -->
                        <buildArg>--initialize-at-run-time=org.slf4j,org.apache.commons.logging,org.apache.logging.slf4j,org.apache.logging.log4j</buildArg>
                        <buildArg>--initialize-at-run-time=io.grpc.netty.shaded</buildArg>
                        <buildArg>--initialize-at-run-time=io.grpc.netty.shaded.io.netty.internal.tcnative</buildArg>
                        <buildArg>--initialize-at-run-time=io.grpc.netty.shaded.io.netty.handler.ssl</buildArg>
                        <buildArg>--initialize-at-run-time=io.grpc.netty.shaded.io.netty.util.internal.SystemPropertyUtil</buildArg>
                        <buildArg>--initialize-at-run-time=io.grpc.netty.shaded.io.netty.util.ResourceLeakDetectorFactory</buildArg>
                        <buildArg>--initialize-at-build-time=ch.qos.logback</buildArg>
                        <buildArg>--exclude-config</buildArg>
                        <buildArg>.*fastjson2.*[.]jar</buildArg>
                        <buildArg>^/META-INF/native-image/</buildArg>
                        <buildArg>--initialize-at-run-time=com.alibaba.fastjson2</buildArg>
                        <buildArg>--initialize-at-build-time=ch.qos.logback.classic.Logger</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>

        </plugins>
        <finalName>${project.artifactId}</finalName>
    </build>


    <!-- native-image: Flink Job is submitted via flink run, not part of the Boot app classpath.
         Excluded at compile time only for native builds (-Pnative,native-flink-exclude). -->
    <profiles>
        <profile>
            <id>native-flink-exclude</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/flink/VehicleTrackFlinkJob.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>

        </plugins>
            </build>
        </profile>
    </profiles>

</project>
