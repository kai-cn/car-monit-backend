<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>pro-api</artifactId>
        <groupId>com.ruoyi</groupId>
        <version>1.0</version>
    </parent>

    <groupId>com.ruoyi</groupId>
    <artifactId>pro-business-api</artifactId>
    <version>1.0</version>
    <name>pro-business-api</name>
    <description>pro-business-api</description>

    <dependencies>
        <!--通用组件-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>pro-base-common</artifactId>
        </dependency>
        <!-- 单元测试（仅 test scope；V3 修复项的自证用，不进入运行时依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Kafka：Boot 4 把 KafkaAutoConfiguration 拆成独立模块，
             必须用 starter 才能拿到 kafkaListenerContainerFactory（原来只引 spring-kafka） -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ==================== Flink 实时轨迹 Job（JDK 17+ / Flink 1.20.3） ====================
             Flink 1.13(Scala 2.11) 无法在 JDK 17 上运行，升级到 1.20.3（最后一个 1.x 稳定线，官方支持 Java 17）。
             作用域统一为 provided：Job 由 Flink 集群/`flink run` 提交执行，不打进 Boot fat jar，
             避免与 spring-kafka 的 kafka-clients 4.x 在同一运行期反复抢版本。 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>${flink-connector-kafka.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Pulsar 客户端（版本由 Boot 4 BOM 的 pulsar-bom 管理） -->
        <dependency>
            <groupId>org.apache.pulsar</groupId>
            <artifactId>pulsar-client</artifactId>
        </dependency>

        <!--
          VehicleTrackFlinkJob 保留：Flink 1.20.3 依赖见本文件上方（provided 作用域）。
          运行方式：用 flink run 提交到 Flink 集群；Boot 应用本身不加载该 Job，
          因此 fat jar 中不打包 org.apache.flink.*。
        -->

        <!-- RocketMQ Spring Boot Starter -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>

        <!-- RabbitMQ Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Elasticsearch High Level REST Client -->
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-high-level-client</artifactId>
        </dependency>

        <!-- Elasticsearch Core -->
        <dependency>
            <groupId>org.elasticsearch</groupId>
            <artifactId>elasticsearch</artifactId>
        </dependency>

        <!-- MySQL JDBC：仅用于读取 carmonitdb.plate_color 字典（单一事实源） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <!-- src/main/resources is filtered=true in the parent pom.
                         The pulsar-xz native patch ships binary .class files there;
                         exclude them from filtering to avoid MalformedInputException. -->
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>class</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                    <mainClass>com.ruoyi.EcBusinessApiApplication</mainClass>
                    <!-- 镜像瘦身：Boot repackage 默认会把 provided 依赖也打进 BOOT-INF/lib。
                         VehicleTrackFlinkJob 由 flink run 提交到集群执行，运行时不需要这些类，
                         显式排除可去掉约 50MB（21 个 flink-* jar）。 -->
                    <excludeGroupIds>org.apache.flink</excludeGroupIds>
                    <!-- 只保留 linux-x86_64 的 native 包，去掉 macOS / Windows / aarch64 变体 -->
                    <excludes>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-transport-native-epoll</artifactId><classifier>linux-aarch_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-transport-native-io_uring</artifactId><classifier>linux-aarch_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-transport-native-kqueue</artifactId><classifier>osx-x86_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-transport-native-kqueue</artifactId><classifier>osx-aarch_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-resolver-dns-native-macos</artifactId><classifier>osx-x86_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-resolver-dns-native-macos</artifactId><classifier>osx-aarch_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-codec-native-quic</artifactId><classifier>linux-aarch_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-codec-native-quic</artifactId><classifier>osx-x86_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-codec-native-quic</artifactId><classifier>osx-aarch_64</classifier></exclude>
                        <exclude><groupId>io.netty</groupId><artifactId>netty-codec-native-quic</artifactId><classifier>windows-x86_64</classifier></exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
                    <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <!-- Boot 3.5 的 BOM 管理到 0.10.6，它对 Mandrel 21 的版本探测会误判
                     （"GraalVM version 22 is required but 21 has been detected"）。
                     与 Boot4 分支保持一致，固定到 1.1.14。 -->
                <version>1.1.14</version>
                <configuration>
                    <!-- Mandrel 21 的 native-image 版本号是 21.0.13（底层 GraalVM 23.1.13），
                         Boot 3.5 的默认 requiredVersion 会把它判成"过低"而中止，
                         这里显式声明实际版本。 -->
                    <requiredVersion>21.0</requiredVersion>
                    <!-- Mandrel 21 (GraalVM 23.1) predates the reachability-metadata
                         schema downloaded by native-maven-plugin 1.1.14; the project
                         ships its own tracing-agent metadata, so disable the repo. -->
                    <metadataRepository>
                        <enabled>false</enabled>
                    </metadataRepository>
                    <!-- grpc-netty-shaded 由 pulsar-client 传递引入（应用在用，不可排除）。
                         其 tcnative JNI 静态引用在 image build 期初始化会 UnsatisfiedLinkError。
                         具体类优先于包级规则，逐个显式延迟到运行时。 -->
                    <buildArgs>
                        <buildArg>-H:IncludeResources=com/mysql/cj/LocalizedErrorMessages.*</buildArg>
                        <!-- 迭代期快速构建（-Ob）；交付构建去掉本行恢复 -O2。 -->
                        <buildArg>-Ob</buildArg>
                        <buildArg>--initialize-at-run-time=io.grpc.netty.shaded</buildArg>
                        <buildArg>--initialize-at-run-time=io.grpc.netty.shaded.io.netty.internal.tcnative</buildArg>
                        <buildArg>--initialize-at-run-time=io.grpc.netty.shaded.io.netty.handler.ssl</buildArg>
                        <buildArg>--initialize-at-build-time=ch.qos.logback</buildArg>
                        <buildArg>--initialize-at-build-time=org.springframework.boot.logging.log4j2.SpringBootPropertySource</buildArg>
                        <buildArg>--exclude-config</buildArg>
                        <buildArg>.*fastjson2.*[.]jar</buildArg>
                        <buildArg>^/META-INF/native-image/</buildArg>
                        <buildArg>--initialize-at-run-time=com.alibaba.fastjson2</buildArg>
                        <buildArg>--initialize-at-build-time=ch.qos.logback.classic.Logger</buildArg>
                        <!-- Mandrel 21 的 ClassInitializationFeature 比 Mandrel 25 严格：
                             凡是"声明为 run-time 但构建期实际被初始化"的类都会中断构建。
                             下列声明让策略与事实一致（实测 r14 构建通过，见
                             docs/v3/native-image-cicd-and-runtime-verification.md §9）。 -->
                        <buildArg>--initialize-at-run-time=io.netty.handler.ssl</buildArg>
                        <buildArg>--initialize-at-run-time=io.netty.channel.kqueue</buildArg>
                        <buildArg>--initialize-at-build-time=org.slf4j,org.apache.commons.logging,org.apache.logging.slf4j,org.apache.logging.log4j</buildArg>
                        <buildArg>--initialize-at-build-time=org.springframework.core.SpringProperties,org.springframework.core.KotlinDetector</buildArg>
                        <buildArg>--initialize-at-build-time=org.springframework.util.ClassUtils,org.springframework.util.ConcurrentReferenceHashMap,org.springframework.util.ConcurrentReferenceHashMap$EntryIterator,org.springframework.util.ConcurrentReferenceHashMap$ReferenceManager,org.springframework.util.ConcurrentReferenceHashMap$ReferenceType,org.springframework.util.ConcurrentReferenceHashMap$1,org.springframework.util.ConcurrentReferenceHashMap$2,org.springframework.util.ConcurrentReferenceHashMap$3,org.springframework.util.ConcurrentReferenceHashMap$4,org.springframework.util.ConcurrentReferenceHashMap$5,org.springframework.util.ConcurrentReferenceHashMap$Reference,org.springframework.util.ConcurrentReferenceHashMap$Task,org.springframework.util.ConcurrentReferenceHashMap$TaskOption,org.springframework.util.ConcurrentReferenceHashMap$EntrySet,org.springframework.util.ConcurrentReferenceHashMap$WeakEntryReference,org.springframework.util.ConcurrentReferenceHashMap$Entry,org.springframework.util.ConcurrentReferenceHashMap$Entries,org.springframework.util.ConcurrentReferenceHashMap$SoftEntryReference,org.springframework.util.ConcurrentReferenceHashMap$Restructure,org.springframework.util.ConcurrentReferenceHashMap$Segment</buildArg>
                        <buildArg>--initialize-at-build-time=org.springframework.data.core.SerializableLambdaReader</buildArg>
                        <buildArg>--initialize-at-build-time=io.grpc.netty.shaded.io.netty.util.internal.PlatformDependent0</buildArg>
                        <buildArg>--initialize-at-build-time=io.grpc.netty.shaded.io.netty.util.internal.SystemPropertyUtil</buildArg>
                        <buildArg>--initialize-at-build-time=io.grpc.netty.shaded.io.netty.util.ResourceLeakDetectorFactory</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>


    <!-- native-image: Flink Job is submitted via flink run, not part of the Boot app classpath.
         Excluded at compile time only for native builds (-Pnative,native-flink-exclude). -->
    <profiles>
        <profile>
            <id>native-flink-exclude</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/flink/VehicleTrackFlinkJob.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>

        </plugins>
            </build>
        </profile>
    </profiles>

</project>
