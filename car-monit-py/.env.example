# =============================================================================
# Migrated from: ruoyi-admin/src/main/resources/application.yml
#
# 这是「配置项对照表」的可执行版本。**密钥类配置必须显式提供**：
# 复制本文件为 `.env` 后，按「必填密钥」一节的说明生成并填写三个值才能启动。
# Copy to `.env` and fill in the three required secrets using the instructions below.
#
# -----------------------------------------------------------------------------
# 优先级 / Precedence (highest first)
#   1. 真实环境变量 / real environment variables
#   2. .env 文件 / the .env file
#   3. config/application.yml
#   4. app/settings.py 中每个字段的默认值 / field defaults
# -----------------------------------------------------------------------------
# 命名规则 / Naming rule
#   application.yml 的层级使用双下划线 `__` 连接，叶子键用 snake_case。
#   Nested YAML keys are joined with `__`; leaf keys use snake_case.
#
#       spring.redis.host        -> SPRING__REDIS__HOST
#       token.secret             -> TOKEN__SECRET
#       spring.datasource.druid.master.url
#                                -> SPRING__DATASOURCE__DRUID__MASTER__URL
#
#   ⚠ 密钥 fail-closed（所有环境）：TOKEN__SECRET、DB 口令、HENGDA__SECRET
#     必须由环境变量提供；缺失、仍是仓库内置演示值、或命中占位词/长度/熵校验
#     （如 dev-only-*-please-change）时应用**拒绝启动**，并在错误信息里列出变量。
#     启用 OSS 时还要求 OSS__ACCESS_KEY / OSS__SECRET_KEY。
#     Startup fails closed in every environment while a required secret is missing
#     or still a built-in demo value / obvious placeholder.
#
# -----------------------------------------------------------------------------
# 上线必查 / go-live checklist（缺一项都不要部署）
#   1. IS_LOCALHOST=prod（或 staging；不能是 local）
#   2. TOKEN__SECRET 换成真实随机密钥
#   3. SPRING__DATASOURCE__DRUID__MASTER__PASSWORD 换成生产库口令
#   4. HENGDA__SECRET 换成真实值
#   5. 若 APP__OSS_ENABLED=true：OSS__ACCESS_KEY / OSS__SECRET_KEY 必须换成真实值
#
#   camelCase / kebab-case 都行（pydantic 按字段名匹配，均为 snake_case）。
#   Both camelCase and kebab-case YAML keys are normalised to snake_case, so the
#   env var always uses the snake_case form.
# =============================================================================
#
#   ⚠ 注意：`logging.level.com.ruoyi` 的 key 含点号，**不能**作为环境变量名。
#     请改用 LOGGING__LEVEL（JSON）或直接改 config/application.yml。
#     The `logging.level.<logger>` keys contain dots and cannot be env vars.
# =============================================================================


# -----------------------------------------------------------------------------
# 运行环境标识 / runtime profile
#   必须显式选择（本文件不再预置 local，避免生产环境误用开发档位）。
#   local：本机开发（DB 口令允许 root）；staging / prod：全部密钥必须真实。
#   Must be chosen explicitly; the safety net is not pre-set to local.
# -----------------------------------------------------------------------------
# IS_LOCALHOST=local

# -----------------------------------------------------------------------------
# 必填密钥（缺失或不合格时启动失败）
#   生成随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
#   要求：至少 32 个字符；不能包含 please-change / changeme / placeholder /
#   dev-only / your-secret 这类占位词（示例值会被 fail-closed 拒绝）。
#   Generate with the command above; placeholders and short values are rejected.
# -----------------------------------------------------------------------------
# TOKEN__SECRET=<至少 32 位的随机值>
# SPRING__DATASOURCE__DRUID__MASTER__PASSWORD=<数据库口令；local 可用 root>
# HENGDA__SECRET=<至少 32 位的随机值>

# -----------------------------------------------------------------------------
# 服务端口 / HTTP port
#   Java: server.port
# -----------------------------------------------------------------------------
# SERVER__PORT=9989
# SERVER__SERVLET__CONTEXT_PATH=/

# -----------------------------------------------------------------------------
# MySQL 数据源 / datasource
#   Java: spring.datasource.druid.master.url / username / password
#   注意 JDBC 前缀 `jdbc:p6spy:mysql://` 会被自动剥离；p6spy 的 SQL 日志
#   由 SQLAlchemy 的 before_cursor_execute 监听器替代。
# -----------------------------------------------------------------------------
# SPRING__DATASOURCE__DRUID__MASTER__URL=jdbc:p6spy:mysql://127.0.0.1:3307/carmonitdb?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8&allowMultiQueries=true
# SPRING__DATASOURCE__DRUID__MASTER__USERNAME=root
# SPRING__DATASOURCE__DRUID__MASTER__PASSWORD=root

# Druid 连接池参数（对应 QueuePool 的 pool_size / max_overflow / pool_timeout）
# SPRING__DATASOURCE__DRUID__INITIAL_SIZE=5
# SPRING__DATASOURCE__DRUID__MIN_IDLE=10
# SPRING__DATASOURCE__DRUID__MAX_ACTIVE=200
# SPRING__DATASOURCE__DRUID__MAX_WAIT=60000

# -----------------------------------------------------------------------------
# Redis
#   Java: spring.redis.*
# -----------------------------------------------------------------------------
# SPRING__REDIS__HOST=127.0.0.1
# SPRING__REDIS__PORT=6379
# SPRING__REDIS__DATABASE=0
# SPRING__REDIS__PASSWORD=
# SPRING__REDIS__TIMEOUT=10s

# -----------------------------------------------------------------------------
# JWT
#   Java: token.*
#   expireTime 单位=分钟（Java 原注释写"30分钟"，实际配置是 120）
# -----------------------------------------------------------------------------
# TOKEN__HEADER=Authorization
# TOKEN__SECRET 在文件顶部“必填密钥”区，按说明填写
# TOKEN__EXPIRE_TIME=120

# -----------------------------------------------------------------------------
# 登录安全 / login guard
#   Java: user.password.maxRetryCount / user.password.lockTime
# -----------------------------------------------------------------------------
# USER__PASSWORD__MAX_RETRY_COUNT=5
# USER__PASSWORD__LOCK_TIME=10

# -----------------------------------------------------------------------------
# 文件目录 / upload profile
#   Java: ruoyi.profile（ResourcesConfig 把 /profile/** 映射到该目录）
# -----------------------------------------------------------------------------
# RUOYI__PROFILE=D:/ruoyi/uploadPath
# RUOYI__NAME=系统

# -----------------------------------------------------------------------------
# 验证码 / captcha
#   Java: ruoyi.captchaType = math | char
# -----------------------------------------------------------------------------
# RUOYI__CAPTCHA_TYPE=math

# -----------------------------------------------------------------------------
# 监控 / tracing
#   Java: monitor.*
# -----------------------------------------------------------------------------
# MONITOR__ENABLED=true
# MONITOR__SLOW_REQUEST_THRESHOLD=3000
# MONITOR__SLOW_SQL_THRESHOLD=1000
# MONITOR__TRACE_ID_HEADER=X-Trace-Id

# -----------------------------------------------------------------------------
# 日志文件容量 / log rotation
#   Python-only：Java logback 是"单文件 100MB × 60 天"，没有目录总量上限；
#   这里额外加了一个日志目录总预算，超出后从最旧的滚动文件开始清理。
# -----------------------------------------------------------------------------
# LOGGING__FILE_MAX_BYTES=104857600          # 单文件 100MB
# LOGGING__FILE_BACKUP_COUNT=30              # 每个文件保留 30 份
# LOGGING__FILE_MAX_TOTAL_BYTES=2147483648   # 整个日志目录 2GB

# -----------------------------------------------------------------------------
# Kafka
#   Java: kafka.*（4 个 @KafkaListener consumer）
#   当前运行环境中 9092 未监听，默认关闭；启动时打印告警。
# -----------------------------------------------------------------------------
# APP__KAFKA_ENABLED=false
# KAFKA__BOOTSTRAP_SERVERS=127.0.0.1:9092
# KAFKA__CONSUMER__GROUP_ID=snapshot-flow-consumer-group
# KAFKA__TOPIC__SNAPSHOT_FLOW=ods-rt-szdn-snapshot-flow

# -----------------------------------------------------------------------------
# Elasticsearch
#   Java: elasticsearch.*
# -----------------------------------------------------------------------------
# APP__ELASTICSEARCH_ENABLED=true
# ELASTICSEARCH__HOST=127.0.0.1
# ELASTICSEARCH__PORT=9200
# ELASTICSEARCH__INDEX=snapshot-flow

# -----------------------------------------------------------------------------
# MinIO / OSS
#   Java: oss.*
#   当前运行环境不可达，默认关闭。
# -----------------------------------------------------------------------------
# APP__OSS_ENABLED=false
# OSS__ENDPOINT=http://172.30.100.102:9002
# OSS__ACCESS_KEY / OSS__SECRET_KEY：启用 OSS 时必填真实值
# OSS__BUCKET_NAME=developer

# -----------------------------------------------------------------------------
# 定时任务 / scheduling
#   APP__SCHEDULER_ENABLED         : 自研内存调度器（等价 Spring Boot 内置 Quartz，见 COMPATIBILITY §12）
#   APP__SCHEDULED_ANNOTATIONS_ENABLED : Java 版没有 @EnableScheduling，
#                                        9 个 @Scheduled 方法实际不触发 -> 默认 false
# -----------------------------------------------------------------------------
# APP__SCHEDULER_ENABLED=true
# APP__SCHEDULED_ANNOTATIONS_ENABLED=false

# -----------------------------------------------------------------------------
# 其它 Python-only 开关
# -----------------------------------------------------------------------------
# 健康检查端点 /health（Java 版没有，见 COMPATIBILITY.md）
# APP__HEALTH_ENDPOINT_ENABLED=true
# 启动横幅
# APP__BANNER_ENABLED=true
# 请求线程池上限（默认 200，与 Druid maxActive 对齐；复刻 Tomcat 800 时改这里）
# APP__REQUEST_THREAD_LIMIT=200
# XSS 清洗前允许缓冲的 JSON/form body 上限（默认 1MB；超过回 413，0 = 不限制）
# XSS__MAX_BODY_BYTES=1048576
# 异步线程池待执行队列上限（默认 1000；满了由调用线程执行，与 Java CallerRunsPolicy 一致）
# APP__EXECUTOR_QUEUE_CAPACITY=1000
# CORS 白名单（JSON 数组）。非 local 留空 = 拒绝所有跨域；
# local 留空 = 仅允许 localhost / 127.0.0.1 / [::1]（任意端口），不再全开。
# APP__CORS__ALLOWED_ORIGINS=["https://admin.example.com","https://ops.example.com"]

# -----------------------------------------------------------------------------
# 外部系统 / external systems
# -----------------------------------------------------------------------------
# VEHICLE_MONITOR__BASE_URL=http://127.0.0.1:9901
# TX_SERVICE_URL=https://apis.map.qq.com
# ROAD_PATH_URL=http://36.200.30.117:8080
# HENGDA__APPID=YHZS
# HENGDA__SECRET 在文件顶部“必填密钥”区，按说明填写
# OSS__ACCESS_KEY / OSS__SECRET_KEY：启用 OSS 时必填真实值

# -----------------------------------------------------------------------------
# 运行期覆盖配置文件路径 / point at a different YAML
# -----------------------------------------------------------------------------
# CM_CONFIG_FILE=config/application.yml
