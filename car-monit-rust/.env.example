# Java application.yml equivalent. Prefix APP_ and use __ for nesting.
APP_PROFILE=default
APP_SERVER__PORT=9989
APP_TOKEN__SECRET=<your-jwt-secret>
APP_DATABASE__URL=mysql://<user>:<password>@127.0.0.1:3307/carmonitdb
APP_DATABASE__USERNAME=<user>
APP_DATABASE__PASSWORD=<password>
APP_REDIS__HOST=127.0.0.1
APP_REDIS__PORT=6379
APP_REDIS__DATABASE=0
APP_APP__HEALTH_ENDPOINT_ENABLED=true
APP_SHARDING__ENABLED=true
RUST_LOG=info,car_monit_rust=debug
